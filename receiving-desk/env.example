# Receiving Desk environment. Run ./ctl init to copy this to .env.
# For production: set DOMAIN to the server's public hostname before running ./ctl init.
# After the stack is up and port 80 is reachable, obtain a real Let's Encrypt certificate:
#   docker compose -f receiving-desk/compose.yml run --rm certbot \
#     certonly --webroot -w /var/www/certbot -d yourdomain.tld
# Then set DOMAIN=yourdomain.tld here and restart nginx:
#   docker compose -f receiving-desk/compose.yml up -d nginx
# The default bootstrap.invalid uses the reserved .invalid TLD — never a trusted cert.
DOMAIN=bootstrap.invalid
