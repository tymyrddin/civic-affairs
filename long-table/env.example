# Long Table (OpenCTI) environment — copy to .env and fill in values. Never commit .env.
# Run ./ctl init to generate secrets automatically.

# OpenCTI admin credentials
OPENCTI_ADMIN_EMAIL=admin@example.internal
OPENCTI_ADMIN_PASSWORD=changeme-strong-password

# Admin token — must be a valid UUID. Generate with: uuidgen
# Used by the worker and MISP connector to authenticate against OpenCTI.
OPENCTI_ADMIN_TOKEN=changeme-opencti-token

# Public base URL — used for links in exports and notifications.
# Default works for local testing. Change for production.
OPENCTI_BASE_URL=http://localhost:8888

# Connector UUID — must be a valid UUID, different from OPENCTI_ADMIN_TOKEN.
# Generate with: uuidgen
CONNECTOR_MISP_ID=changeme-connector-misp-id

# MISP integration
# MISP_API_KEY must match ADMIN_KEY in misp/.env — ./ctl init sets both together.
# Leave as placeholder and the MISP connector will not start.
# Default matches MISP BASE_URL for local testing. Change for production.
MISP_BASEURL=https://127.0.0.1:8443
MISP_API_KEY=changeme-misp-api-key

# Internal service credentials
OPENCTI_REDIS_PASSWORD=changeme-strong-password
MINIO_ROOT_USER=opencti
MINIO_ROOT_PASSWORD=changeme-strong-password
RABBITMQ_USER=opencti
RABBITMQ_PASSWORD=changeme-strong-password
