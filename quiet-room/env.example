# Quiet Room environment — copy to .env and fill in values. Never commit .env.
# Run ./ctl init to generate secrets automatically.

# Network interface for packet capture.
# Run `ip link show` to list interfaces; pick the one carrying monitored traffic.
# Suricata and Zeek will not start without this. ./ctl up validates it before starting.
SENSOR_INTERFACE=

# Wazuh API credentials — API_USERNAME and API_PASSWORD are read by the
# wazuh-manager container to configure the built-in API user on startup.
API_USERNAME=wazuh-wui
API_PASSWORD=changeme-strong-password

# MISP integration for the sensor classifier.
# MISP_API_KEY is synced automatically from misp/.env by ./ctl init.
# MISP_URL is the container-to-container address on pipeline-net.
MISP_URL=https://misp:443
MISP_VERIFYCERT=false
MISP_API_KEY=changeme-misp-api-key

# Classifier behaviour. Defaults work as-is; override only to tune.
# ZEEK_LOGS: comma-separated Zeek log files to tail from the mounted volume.
# QR_CORRELATION_WINDOW: seconds within which a Suricata alert and a Zeek log on
# the same host combine into one reliability-3 event held for analyst review.
ZEEK_LOGS=dns.log
QR_CORRELATION_WINDOW=600
