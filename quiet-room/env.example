# Quiet Room environment — copy to .env and fill in values. Never commit .env.
# Run ./ctl init to generate secrets automatically.

# Network interface for packet capture.
# Run `ip link show` to list interfaces; pick the one carrying monitored traffic.
# Suricata and Zeek will not start without this. ./ctl up validates it before starting.
SENSOR_INTERFACE=

# Wazuh API credentials — API_USERNAME and API_PASSWORD are read by the
# wazuh-manager container to configure the built-in API user on startup.
API_USERNAME=wazuh-wui
API_PASSWORD=changeme-strong-password
