# MISP environment — copy to .env and fill in values. Never commit .env.

# Database credentials
MYSQL_DATABASE=misp
MYSQL_USER=misp
MYSQL_PASSWORD=changeme-strong-password
MYSQL_ROOT_PASSWORD=changeme-different-strong-password

# Redis
REDIS_PASSWORD=changeme-strong-password

# MISP application
MISP_ADMIN_EMAIL=admin@example.internal
MISP_ADMIN_PASSPHRASE=changeme-before-first-login
MISP_BASEURL=https://misp.internal
MISP_ORG=CivicDefenceEstablishment
