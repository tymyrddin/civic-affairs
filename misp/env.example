# MISP environment — copy to .env and fill in values. Never commit .env.
# Run ./ctl init to generate secrets automatically.

# Database credentials
MYSQL_DATABASE=misp
MYSQL_USER=misp
MYSQL_PASSWORD=changeme-strong-password
MYSQL_ROOT_PASSWORD=changeme-strong-root-password

# Redis password (shared between MISP and the redis container)
REDIS_PASSWORD=changeme-strong-password

# Admin account
ADMIN_EMAIL=admin@example.internal
ADMIN_PASSWORD=changeme-strong-password
ADMIN_ORG=Civic Defence Establishment

# Admin API key — set to a long random string (hex, 32+ chars).
# Set the same value as MISP_API_KEY in long-table/.env.
# MISP applies this key to the admin account on every start.
ADMIN_KEY=changeme-misp-api-key

# GPG passphrase for signing MISP exports
GPG_PASSPHRASE=changeme-gpg-passphrase

# Public base URL — used for redirects and links.
# Default works for local testing. Change for production.
BASE_URL=https://127.0.0.1:8443
